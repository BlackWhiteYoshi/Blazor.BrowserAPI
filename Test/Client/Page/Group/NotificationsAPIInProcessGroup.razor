@namespace BrowserAPI.Test.Client

<div class="group">
    <h2>Notifications API InProcess</h2>
    <div>
        @* NotificationsAPI *@

        <button data-testid="@BUTTON_PERMISSION" @onclick="Permission">Permission</button>
        <button data-testid="@BUTTON_MAX_ACTIONS" @onclick="MaxActions">MaxActions</button>

        <button data-testid="@BUTTON_REQUEST_PERMISSION" @onclick="RequestPermission">RequestPermission</button>
        <button data-testid="@BUTTON_CREATE_NOTIFICATION" @onclick="CreateNotification">CreateNotification</button>

        @* Notification *@

        <button data-testid="@BUTTON_ACTIONS" @onclick="Actions">Actions</button>
        <button data-testid="@BUTTON_BADGE" @onclick="Badge">Badge</button>
        <button data-testid="@BUTTON_BODY" @onclick="Body">Body</button>
        <button data-testid="@BUTTON_DATA" @onclick="Data">Data</button>
        <button data-testid="@BUTTON_DIR" @onclick="Dir">Dir</button>
        <button data-testid="@BUTTON_ICON" @onclick="Icon">Icon</button>
        <button data-testid="@BUTTON_IMAGE" @onclick="Image">Image</button>
        <button data-testid="@BUTTON_LANG" @onclick="Lang">Lang</button>
        <button data-testid="@BUTTON_NAVIGATE" @onclick="Navigate">Navigate</button>
        <button data-testid="@BUTTON_RENOTIFY" @onclick="Renotify">Renotify</button>
        <button data-testid="@BUTTON_REQUIRE_INTERACTION" @onclick="RequireInteraction">RequireInteraction</button>
        <button data-testid="@BUTTON_SILENT" @onclick="Silent">Silent</button>
        <button data-testid="@BUTTON_TAG" @onclick="Tag">Tag</button>
        <button data-testid="@BUTTON_TIMESTAMP" @onclick="Timestamp">Timestamp</button>
        <button data-testid="@BUTTON_TITLE" @onclick="Title">Title</button>
        <button data-testid="@BUTTON_VIBRATE" @onclick="Vibrate">Vibrate</button>

        <button data-testid="@BUTTON_CLOSE" @onclick="Close">Close</button>

        <button data-testid="@BUTTON_REGISTER_ON_CLICK" @onclick="RegisterOnClick">RegisterOnClick</button>
        <button data-testid="@BUTTON_REGISTER_ON_CLOSE" @onclick="RegisterOnClose">RegisterOnClose</button>
        <button data-testid="@BUTTON_REGISTER_ON_ERROR" @onclick="RegisterOnError">RegisterOnError</button>
        <button data-testid="@BUTTON_REGISTER_ON_SHOW" @onclick="RegisterOnShow">RegisterOnShow</button>
    </div>
    <span data-testid="@OUTPUT">@output</span>
</div>
