@namespace BrowserAPI.Test.Client

<div class="group">
    <h2>Notifications API</h2>
    <div>
        @* NotificationsAPI *@

        <button data-testid="@BUTTON_PERMISSION_PROPERTY" @onclick="Permission_Property">Permission_Property</button>
        <button data-testid="@BUTTON_PERMISSION_METHOD" @onclick="Permission_Method">Permission_Method</button>
        <button data-testid="@BUTTON_MAX_ACTIONS_PROPERTY" @onclick="MaxActions_Property">MaxActions_Property</button>
        <button data-testid="@BUTTON_MAX_ACTIONS_METHOD" @onclick="MaxActions_Method">MaxActions_Method</button>

        <button data-testid="@BUTTON_REQUEST_PERMISSION" @onclick="RequestPermission">RequestPermission</button>
        <button data-testid="@BUTTON_CREATE_NOTIFICATION" @onclick="CreateNotification">CreateNotification</button>

        @* Notification *@

        <button data-testid="@BUTTON_ACTIONS_PROPERTY" @onclick="Actions_Property">Actions_Property</button>
        <button data-testid="@BUTTON_ACTIONS_METHOD" @onclick="Actions_Method">Actions_Method</button>
        <button data-testid="@BUTTON_BADGE_PROPERTY" @onclick="Badge_Property">Badge_Property</button>
