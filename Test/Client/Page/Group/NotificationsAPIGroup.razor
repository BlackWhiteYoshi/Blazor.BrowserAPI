        <button data-testid="@BUTTON_DATA_PROPERTY" @onclick="Data_Property">Data_Property</button>
        <button data-testid="@BUTTON_DATA_METHOD" @onclick="Data_Method">Data_Method</button>
        <button data-testid="@BUTTON_DIR_PROPERTY" @onclick="Dir_Property">Dir_Property</button>
        <button data-testid="@BUTTON_DIR_METHOD" @onclick="Dir_Method">Dir_Method</button>
        <button data-testid="@BUTTON_ICON_PROPERTY" @onclick="Icon_Property">Icon_Property</button>
        <button data-testid="@BUTTON_ICON_METHOD" @onclick="Icon_Method">Icon_Method</button>
        <button data-testid="@BUTTON_IMAGE_PROPERTY" @onclick="Image_Property">Image_Property</button>
        <button data-testid="@BUTTON_IMAGE_METHOD" @onclick="Image_Method">Image_Method</button>
        <button data-testid="@BUTTON_LANG_PROPERTY" @onclick="Lang_Property">Lang_Property</button>
        <button data-testid="@BUTTON_LANG_METHOD" @onclick="Lang_Method">Lang_Method</button>
