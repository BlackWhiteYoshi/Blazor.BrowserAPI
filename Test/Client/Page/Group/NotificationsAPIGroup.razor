        <button data-testid="@BUTTON_RENOTIFY_METHOD" @onclick="Renotify_Method">Renotify_Method</button>
        <button data-testid="@BUTTON_REQUIRE_INTERACTION_PROPERTY" @onclick="RequireInteraction_Property">RequireInteraction_Property</button>
        <button data-testid="@BUTTON_REQUIRE_INTERACTION_METHOD" @onclick="RequireInteraction_Method">RequireInteraction_Method</button>
        <button data-testid="@BUTTON_SILENT_PROPERTY" @onclick="Silent_Property">Silent_Property</button>
        <button data-testid="@BUTTON_SILENT_METHOD" @onclick="Silent_Method">Silent_Method</button>
        <button data-testid="@BUTTON_TAG_PROPERTY" @onclick="Tag_Property">Tag_Property</button>
        <button data-testid="@BUTTON_TAG_METHOD" @onclick="Tag_Method">Tag_Method</button>
        <button data-testid="@BUTTON_TIMESTAMP_PROPERTY" @onclick="Timestamp_Property">Timestamp_Property</button>
