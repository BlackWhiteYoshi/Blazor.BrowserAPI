@namespace BrowserAPI.Demo.Client

@if (!RendererInfo.IsInteractive) {
    <div id="app-loading-progress">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100">
            <circle r="46" cx="50" cy="50" stroke-width="4" />
            <circle r="46" cx="50" cy="50" stroke-width="4" />
        </svg>
    </div>
}

<dialog id="js-error-dialog" @ref="dialogElement">
    <h2 class="headline">Not Working BrowserAPI</h2>
    <p>The requested BrowserAPI is not enabled because of missing permissions or configs or is just not supported by your Browser.</p>
    <p>Ensure giving permissions, look at your configs, try another Browser or just go on with another BrowserAPI example.</p>
    <button class="btn-main" @onclick="CloseDialog">Close</button>
</dialog>

<AppNavBar />

<JSExceptionBoundary @ref="jsExceptionBoundary">
    <main>
        <Router AppAssembly="@typeof(App).Assembly" NotFoundPage="typeof(NotFound)">
            <Found Context="routeData">
                <RouteView RouteData="@routeData" />
                <FocusOnNavigate RouteData="@routeData" Selector="h1" />
            </Found>
        </Router>
    </main>
</JSExceptionBoundary>
