@namespace BrowserAPI.Demo.Client
@page "/document"

<div id="document">
    <h1 class="headline">Document</h1>

    <div class="description">
        <p>The <i>Document</i> interface represents any web page loaded in the browser and serves as an entry point into the web page's content, which is the DOM tree.</p>
        <p>
            The DOM tree includes elements such as &lt;body&gt; and &lt;table&gt;, among many others.
            It provides functionality globally to the document, like how to obtain the page's URL and create new elements in the document.
        </p>
        <p>
            The <i>Document</i> interface describes the common properties and methods for any kind of document.
            Depending on the document's type (e.g., HTML, XML, SVG, …), a larger API is available:
            HTML documents, served with the "text/html" content type, also implement the HTMLDocument interface,
            whereas XML and SVG documents implement the XMLDocument interface.
        </p>
    </div>

    <div class="demo">
        <div>
            <button class="btn-main" @onclick="ChangeTitle" disabled=@(originalTitle is not null)>Set Title</button>
            @if (originalTitle is not null) {
                <input @bind-value="Title" @bind-value:event="oninput">
            }
        </div>
        <button class="btn-deny" @onclick="ColorAllHyperLinks" disabled=@linksAltered>Color all links</button>
        <div>
            <button class="btn-danger" @onclick="RemoveActiveElement">Remove active element</button>
        </div>
        <button class="btn-info" @onclick="ListEntireDOM" disabled=@(domTree is not null)>List entire DOM</button>
        @if (domTree is not null) {
            RenderDomNOde(__builder, domTree.Value);
        }
    </div>
</div>

@code {
    private void RenderDomNOde(RenderTreeBuilder __builder, DomElement domElement) {
        <ul>
            <li>tag: "@domElement.TagName"</li>
            @if (domElement.Attributes.Count > 0) {
                <li>
                    attributes:
                    <ul>
                        @foreach((string key, string value) in domElement.Attributes) {
                            <li>@key = @value</li>
                        }
                    </ul>
                </li>
            }
            @if (domElement.Children.Length > 0) {
                <li>
                    children:
                    @foreach(DomElement child in domElement.Children) {
                        RenderDomNOde(__builder, child);
                    }
                </li>
            }
        </ul>
    }
}
