@namespace BrowserAPI.Demo.Client
@page "/history"

<div id="history">
    <h1 class="headline">History</h1>

    <div class="description">
        <p>
            The <i>History</i> interface of the <a href="https://developer.mozilla.org/en-US/docs/Web/API/History_API">History API</a> allows manipulation of the browser session history,
            that is the pages visited in the tab or frame that the current page is loaded in.
        </p>
        <p>There is only one instance of history (It is a singleton.) accessible via the global object history.</p>
    </div>

    <div class="demo">
        <button class="btn-main" @onclick="GetLength">History length</button>
        <span>Length: @(length is not null ? length : "---")</span>

        <button class="btn-second" @onclick="GetScrollRestoration">History scroll restoration</button>
        <span>ScrollRestoration: @(scrollRestoration is not null ? scrollRestoration : "---")</span>

        <button class="btn-deny" @onclick="Back">Go Back</button>
        <button class="btn-deny" @onclick="Forward">Go Forward</button>
    </div>
</div>
