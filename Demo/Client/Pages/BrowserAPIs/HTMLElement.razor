@namespace BrowserAPI.Demo.Client
@page "/htmlelement"

<div id="html-element">
    <h1 class="headline">HTMLElement</h1>

    <div class="description">
        <p>
            The <i>HTMLElement</i> interface represents any HTML element.
            Some elements directly implement this interface, while others implement it via an interface that inherits it.
        </p>
    </div>

    <div class="demo">
        <div class="button-div">
            <button class="btn-deny" @onclick="AddCircle">Add circle</button>
            <button class="btn-danger" @onclick="RemoveCircle" disabled=@(circleCount is 0)>Remove circle</button>
        </div>
        <div class="circle-div" @ref="divElement">
            @for (int i = 0; i < circleCount; i++) {
                <div class="circle"></div>
            }
        </div>
        <div class="output-div">
            <span>Gray box width: @width</span>
            <span>Gray box height: @height</span>
        </div>
    </div>
</div>
