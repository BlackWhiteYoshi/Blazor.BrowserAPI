@namespace BrowserAPI.Demo.Client
@page "/htmlmediaelement"

<div id="html-media-element">
    <h1 class="headline">HTMLMediaElement</h1>

    <div class="description">
        <p>The <i>HTMLMediaElement</i> interface adds to HTMLElement the properties and methods needed to support basic media-related capabilities that are common to audio and video.</p>
        <p>
            The <a href="https://developer.mozilla.org/en-US/docs/Web/API/HTMLVideoElement">HTMLVideoElement</a>
            and <a href="https://developer.mozilla.org/en-US/docs/Web/API/HTMLAudioElement">HTMLAudioElement</a>
            elements both inherit this interface.
        </p>
    </div>

    <div class="demo">
        <div>
            <button class="btn-main" @onclick="PlayAudio">Play</button>
            <button class="btn-second" @onclick="PauseAudio">Pause</button>
            <button class="btn-info" @onclick="ResetAudio">Reset to beginning</button>
            <button class="@(!isDoubleSpeedAudio ? "btn-cancel" : "btn-deny")" @onclick="ToggleSpeedAudio">Toggle 2x speed</button>
            <button class="@(!isMutedAudio ? "btn-cancel" : "btn-deny")" @onclick="ToggleMutedAudio">Toggle muted</button>
            <button class="@(!isHalfVolumeAudio ? "btn-cancel" : "btn-deny")" @onclick="ToggleVolumeAudio">Toggle half volume</button>
        </div>
        <audio src="sample.mp3" controls loading="lazy" preload="none" @ref="audioElement"></audio>

        <div>
            <button class="btn-main" @onclick="PlayVideo">Play</button>
            <button class="btn-second" @onclick="PauseVideo">Pause</button>
            <button class="btn-info" @onclick="ResetVideo">Reset to beginning</button>
            <button class="@(!isDoubleSpeedVideo ? "btn-cancel" : "btn-deny")" @onclick="ToggleSpeedVideo">Toggle 2x speed</button>
            <button class="@(!isMutedVideo ? "btn-cancel" : "btn-deny")" @onclick="ToggleMutedVideo">Toggle muted</button>
            <button class="@(!isHalfVolumeVideo ? "btn-cancel" : "btn-deny")" @onclick="ToggleVolumeVideo">Toggle half volume</button>
            <button class="btn-danger" @onclick="OpenPictureInPicture">Open picture in picture</button>
        </div>
        <video src="sample.mp4" width="480" height="270" controls loading="lazy" preload="none" @ref="videoElement"></video>
    </div>
</div>
