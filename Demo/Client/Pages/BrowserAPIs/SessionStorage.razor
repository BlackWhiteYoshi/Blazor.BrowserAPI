@namespace BrowserAPI.Demo.Client
@page "/sessionstorage"

<div id="session-storage">
    <h1 class="headline">SessionStorage</h1>

    <div class="description">
        <p>
            The read-only <i>sessionStorage</i> property accesses a session Storage object for the current origin.
            <i>sessionStorage</i> is similar to <i>localStorage</i>; the difference is that while data in <i>localStorage</i> doesn't expire, data in <i>sessionStorage</i> is cleared when the page session ends.
        </p>
    </div>

    <div class="demo">
        <button class="btn-main" @onclick="LoadSessionStorage" disabled=@StorageLoaded>Load session storage</button>

        @if (StorageLoaded) {
            <div>
                <div>
                    <button class="btn-second" @onclick="OnCreateItem">Create item</button>
                    <button class="btn-danger" @onclick="OnDeleteAllItems" disabled=@(items!.Length is 0)>Remove all items</button>
                </div>
                <span>Items Count: @items.Length</span>
                <ul>
                    @for (int i = 0; i < items.Length; i++) {
                        int index = i;
                        <li>
                            <input value="@items[i].key" @onchange="(ChangeEventArgs e) => OnKeyUpdate(e, index)">
                            <input value="@items[i].value" @onchange="(ChangeEventArgs e) => OnValueUpdate(e, index)">
                            <button class="btn-danger" @onclick="() => OnDeleteItem(index)">Remove item</button>
                        </li>
                    }
                </ul>
            </div>
        }
    </div>
</div>
