@namespace BrowserAPI.Demo.Client
@page "/geolocation"

<div id="geolocation">
    <h1 class="headline">Geolocation</h1>

    <div class="description">
        <p>
            The <i>Geolocation API</i> allows the user to provide their location to web applications if they so desire.
            For privacy reasons, the user is asked for permission to report location information.
        </p>
    </div>

    <div class="demo">
        <button class="btn-main" @onclick="GetCurrentPosition">Get current position</button>
        <div>
            <button class="btn-deny" @onclick="WatchPosition" disabled=@isWatching>Start watch position</button>
            <button class="btn-cancel" @onclick="ClearPosition" disabled=@(!isWatching)>Stop watching</button>
        </div>
        @if (HasCoordinates) {
            <span>
                Latitude: @coordinates.Latitude<br>
                Longitude: @coordinates.Longitude<br>
                Altitude: @(coordinates.Altitude?.ToString() ?? "null")<br>
                Accuracy: @coordinates.Accuracy<br>
                AltitudeAccuracy: @(coordinates.AltitudeAccuracy?.ToString() ?? "null")<br>
                Heading: @(coordinates.Heading?.ToString() ?? "null")<br>
                Speed: @(coordinates.Speed?.ToString() ?? "null")<br>
                Timestamp: @coordinates.Timestamp
            </span>
        }
    </div>
</div>
