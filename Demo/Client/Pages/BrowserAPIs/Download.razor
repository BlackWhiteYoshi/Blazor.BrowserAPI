@namespace BrowserAPI.Demo.Client
@page "/download"

<div id="download">
    <h1 class="headline">Download</h1>

    <div class="description">
        <p>Save data as a file download on the filesystem.</p>
        <p>For file upload use the <a href="https://learn.microsoft.com/en-us/dotnet/api/microsoft.aspnetcore.components.forms.inputfile">InputFile component</a>.</p>
    </div>

    <div class="demo">
        <textarea @bind="textAreaContent"></textarea>
        <button class="btn-main" @onclick="DownloadTextAreaContent">Savs text as file.txt</button>
    </div>
</div>
