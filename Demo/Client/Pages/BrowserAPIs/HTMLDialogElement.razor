@namespace BrowserAPI.Demo.Client
@page "/htmldialogelement"

<div id="html-dialog-element">
    <h1 class="headline">HTMLDialogElement</h1>

    <div class="description">
        <p>
            The <i>HTMLDialogElement</i> interface provides methods to manipulate &lt;dialog&gt; elements.
            It inherits properties and methods from the HTMLElement interface.
        </p>
    </div>

    <div class="demo">
        <button class="btn-main" @onclick="Open" disabled=@isOpen>Open dialog</button>
        <button class="btn-second" @onclick="OpenModal" disabled=@isOpen>Open dialog as modal</button>
        <dialog class="info-dialog" @ref="dialogElement">
            <h2 class="headline">Dialog</h2>
            <p>A dialog showcase</p>
            <button class="btn-main" @onclick="Close">Close</button>
        </dialog>
    </div>
</div>
