@namespace BrowserAPI.Demo.Client
@page "/mediadevices"

<div id="media-devices">
    <h1 class="headline">MediaDevices</h1>

    <div class="description">
        <p>
            The <i>MediaDevices</i> interface of the Media Capture and Streams API provides access to connected media input devices like cameras and microphones, as well as screen sharing.
            In essence, it lets you obtain access to any hardware source of media data.
        </p>
    </div>

    <div class="demo">
        <div>
            <button class="btn-main" @onclick="StartRecordingAudio" disabled=@isRecording">Start recording audio</button>
            <button class="btn-deny" @onclick="StopRecording" disabled=@(!isRecording || hasVideoData)>Stop recording audio</button>

            @* download audio as file *@
            <button class="btn-info" @onclick="SaveAsFile" disabled=@(isRecording || mediaData.Count == 0 || hasVideoData)>Download audio as file</button>
            <span error=@(mimeTypeError && !hasVideoData)>@(!hasVideoData && mimeType != string.Empty ? $"Encoding: {mimeType}" : "no recorded data")</span>
        </div>

        @* live playback of stream *@
        <audio controls @ref="audioElement"></audio>


        <div>
            <button class="btn-main" @onclick="StartRecordingVideo" disabled=@isRecording>Start recording video only</button>
            <button class="btn-second" @onclick="StartRecordingVideoAudio" disabled=@isRecording>Start recording video with audio</button>
            <button class="btn-deny" @onclick="StopRecording" disabled=@(!isRecording || !hasVideoData)>Stop recording video</button>

            @* download video as file *@
            <button class="btn-info" @onclick="SaveAsFile" disabled=@(isRecording || mediaData.Count == 0 || !hasVideoData)>Download video as file</button>
            <span error=@(mimeTypeError && hasVideoData)>@(hasVideoData && mimeType != string.Empty ? $"Encoding: {mimeType}" : "no recorded data")</span>
        </div>

        @* live playback of stream *@
        <video width="640" height="480" controls @ref="videoElement"></video>
    </div>
</div>
